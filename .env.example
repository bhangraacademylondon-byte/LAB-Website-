# Port the web server listens on
PORT=3000
# First admin account (only used when no admin exists yet)
ADMIN_EMAIL=admin@londonacademyofbhangra.org
ADMIN_PASSWORD=change-me-please

# Production database (Supabase → Connect → "Session pooler" connection string).
# Leave empty for local development: an embedded Postgres is stored in DATA_DIR.
DATABASE_URL=
# Uploaded images (Supabase → Project Settings → API). Leave empty to store them in DATA_DIR/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Where local data (embedded database, uploads) is kept when the values above are empty
DATA_DIR=./data
# Optional: Instagram long-lived access token (can also be set in Admin → Instagram)
INSTAGRAM_ACCESS_TOKEN=
# Number of reverse proxies in front of the app (1 for Render and most hosts). 0 if exposed directly.
TRUST_PROXY=1
