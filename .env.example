# Port the web server listens on
PORT=3000
# First admin account (only used when no admin exists yet)
ADMIN_EMAIL=admin@londonacademyofbhangra.org
ADMIN_PASSWORD=change-me-please
# Where the database and uploaded images are stored (use a persistent disk in production)
DATA_DIR=./data
# Optional: Instagram long-lived access token (can also be pasted in Admin → Instagram)
INSTAGRAM_ACCESS_TOKEN=
# Number of reverse proxies in front of the app (1 for most hosts). Set to 0 if exposed directly.
TRUST_PROXY=1
