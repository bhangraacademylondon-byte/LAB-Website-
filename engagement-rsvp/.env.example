# Port the web server listens on
PORT=3000

# Admin login. The account is created on first start if it doesn't exist.
ADMIN_EMAIL=Ravi.akshee@gmail.com
ADMIN_PASSWORD=change-me-please
# Set to 1 (once) to reset the ADMIN_EMAIL account's password to ADMIN_PASSWORD on the next start.
ADMIN_PASSWORD_RESET=

# Production database (Supabase → Connect → "Session pooler" connection string).
# Leave empty for local use: an embedded Postgres is stored in DATA_DIR.
DATABASE_URL=
# Photos (Supabase → Project Settings → API). Leave empty to store them in DATA_DIR/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email updates when someone RSVPs. Set ONE of these (both have free plans):
#   Resend: https://resend.com → API Keys. Without your own domain, Resend only
#           delivers to the email address you signed up with.
#   Brevo:  https://www.brevo.com → SMTP & API → API Keys. EMAIL_FROM must be a sender you verified in Brevo.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender shown on the emails. With Resend and no domain, leave it empty (onboarding@resend.dev is used).
EMAIL_FROM=
# Web address of the site, used for links in emails (e.g. https://ravi-akshee.onrender.com)
PUBLIC_URL=

# Where local data is kept when the values above are empty
DATA_DIR=./data
# Number of reverse proxies in front of the app (1 for Render and most hosts). 0 if exposed directly.
TRUST_PROXY=1
